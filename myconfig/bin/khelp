#!/usr/bin/env bash
set -euo pipefail

BASE_CONF="${KITTY_BASE_CONF:-$HOME/.config/myconfig/kitty/base.conf}"
BIN_DIR="${MYCONFIG_BIN_DIR:-$HOME/.config/myconfig/bin}"

cmd_desc() {
  case "${1:-}" in
    kblue) echo "Open Blue profile window: kblue [row1_cols 2-5] [row2_cols 1-2]" ;;
    kgreen) echo "Open Green profile window: kgreen [row1_cols 2-5] [row2_cols 1-2]" ;;
    kred) echo "Open Red profile window: kred [row1_cols 2-5] [row2_cols 1-2]" ;;
    kprofiles) echo "Print profile usage summary" ;;
    krc) echo "Run kitty @ against shared socket: krc <subcommand...>" ;;
    kctl) echo "Run kitty @ against current instance (fallback to krc)" ;;
    kensure) echo "Ensure live kitty remote-control socket target" ;;
    kwindows) echo "List windows across instances + send by unique uid" ;;
    kcolors) echo "Show ANSI/truecolor palette samples in terminal" ;;
    icat) echo "Show images in kitty terminal via kitten icat" ;;
    kshow) echo "Show images in a side window next to this one (works from Claude Code): kshow img... | kshow --close" ;;
    ktemp) echo "Run in the Claude column's TEMP shell: ktemp <cmd> | ktemp --split [--title T] <cmd>" ;;
    kfloat) echo "Show images or image URLs in a floating centered panel: kfloat <file|url>..." ;;
    kdoctor) echo "Check the AddeKitty + Claude Code setup (read-only)" ;;
    kdelete) echo "Delete saved layout(s): kdelete <name...> | kdelete --list" ;;
    kset) echo "Recolor the current tab to a profile: kset <green|blue|red>" ;;
    ksend) echo "Pick a kitty window by yabai space/position and send it a message (needs yabai)" ;;
    kitty) echo "Single-instance kitty launcher (pin this instead of kitty.app)" ;;
    s) echo "Kitty SSH wrapper: s <host>" ;;
    qat) echo "Open/toggle quick access terminal" ;;
    nrun) echo "Run command and send desktop notify: nrun <command...>" ;;
    kapprove) echo "Start/stop/status/toggle Claude Code auto-approver: kapprove [start|stop|status|toggle]" ;;
    khelp) echo "Show this help (commands + hotkeys)" ;;
    ksave) echo "Save current kitty tab layout: ksave [name]" ;;
    kload) echo "Restore a saved layout: kload [name|--list]" ;;
    ktabname) echo "Rename the current tab: ktabname <title...> (no title: automatic)" ;;
    kwindowname) echo "Rename the current window/pane: kwindowname <title...> (no title: automatic)" ;;
    *) echo "Custom command" ;;
  esac
}

print_header() {
  printf 'Kitty + Shell Quick Help\n'
  printf '========================\n\n'
}

print_commands() {
  local known=(khelp kdoctor kfloat kapprove kblue kgreen kred kprofiles krc kctl kensure kwindows kcolors icat kshow ktemp ksave kload kdelete ktabname kwindowname kset ksend s qat nrun)
  local cmd extra

  printf 'Commands (%s)\n' "$BIN_DIR"
  printf '%s\n' '-------------------------'
  for cmd in "${known[@]}"; do
    if [[ -x "$BIN_DIR/$cmd" ]]; then
      printf '  %-10s %s\n' "$cmd" "$(cmd_desc "$cmd")"
    fi
  done

  if [[ -d "$BIN_DIR" ]]; then
    while IFS= read -r extra; do
      [[ " ${known[*]} " == *" $extra "* ]] && continue
      printf '  %-10s %s\n' "$extra" "$(cmd_desc "$extra")"
    done < <(find "$BIN_DIR" -maxdepth 1 -type f -perm -u+x -print | xargs -n1 basename | sort)
  fi
  printf '\n'
}

print_hotkeys() {
  printf 'Hotkeys (%s)\n' "$BASE_CONF"
  printf '%s\n' '-------------------------'
  if [[ ! -f "$BASE_CONF" ]]; then
    printf '  base config not found\n\n'
    return
  fi

  awk '
    $1 == "map" {
      key = $2
      $1 = ""
      $2 = ""
      sub(/^ +/, "", $0)
      printf "  %-20s %s\n", key, $0
    }
  ' "$BASE_CONF"
  printf '\n'
}

print_examples() {
  cat <<'EOF'
Common examples
-------------------------
  kblue 4 2
  kgreen 5 2
  kred 4 2
  kcolors 256
  icat ~/.config/kitty/backgrounds/wolf-hacker-bg.jpg
  kwindows list
  kwindows send-enter '/tmp/kitty-main-12345::67' 'clear'
  krc ls
  s my-server
  nrun long-command --flag
EOF
}

print_header
print_commands
print_hotkeys
print_examples
